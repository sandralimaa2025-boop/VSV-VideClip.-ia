# GEMINI_API_KEY: Required for Gemini AI Director & scriptwriting logic.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VIDEO_API_KEY: (Opcional) Chave externa para provedores de vídeo como Runway / Luma / Kling / Fal / Replicate.
# Se não fornecida, o CLIPE AI opera com o Motor de Direção Gemini e o Simulador Audiovisual Demonstrativo de Alta Fidelidade.
VIDEO_API_KEY=""

# IMAGE_API_KEY: (Opcional) Chave externa para provedor de geração de imagens dos storyboards.
IMAGE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

